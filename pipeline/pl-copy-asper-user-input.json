{
	"name": "pl-copy-asper-user-input",
	"properties": {
		"activities": [
			{
				"name": "Get Metadatafroinputfolder",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "filetype"
					}
				],
				"typeProperties": {
					"dataset": {
						"referenceName": "Json4",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "JsonReadSettings"
					}
				}
			},
			{
				"name": "FilterFileTypes",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Get Metadatafroinputfolder",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [
					{
						"name": "filetype"
					}
				],
				"typeProperties": {
					"items": {
						"value": "@activity('Get Metadatafroinputfolder').output.itemType",
						"type": "Expression"
					},
					"condition": {
						"value": "@endsWith(item().name, pipeline().parameters.Filetype)",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"filetype": {
				"type": "String"
			}
		},
		"annotations": []
	}
}