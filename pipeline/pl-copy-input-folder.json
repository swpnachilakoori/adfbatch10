{
	"name": "pl-copy-input-folder",
	"properties": {
		"activities": [
			{
				"name": "Get Metadatacopy inputfolder",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "foldercopyinput",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "FilterFileType",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Get Metadatacopy inputfolder",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get Metadatacopy inputfolder').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@endsWith(item().name, pipeline().parameters.filetype)",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"filename": {
				"type": "string"
			},
			"foldername": {
				"type": "string"
			},
			"filetype": {
				"type": "String"
			}
		},
		"annotations": []
	}
}