{
	"name": "pipelineparquet",
	"properties": {
		"activities": [
			{
				"name": "copydataindianrailway",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "sourcefile",
						"value": "input"
					},
					{
						"name": "targetfile",
						"value": "output"
					}
				],
				"typeProperties": {
					"source": {
						"type": "ParquetSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "ParquetReadSettings"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "Parquet1",
						"type": "DatasetReference",
						"parameters": {
							"foldername": "input",
							"filename": "india_railway_stations.parquet"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "Parquet1",
						"type": "DatasetReference",
						"parameters": {
							"foldername": "output",
							"filename": {
								"value": "@concat(pipeline().parameters.targetfile,'_',formatDateTime(utcNow(),'ddMMyyyy'))",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"sourcefilename": {
				"type": "string"
			},
			"targetfile": {
				"type": "string"
			}
		},
		"annotations": []
	}
}