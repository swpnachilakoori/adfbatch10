{
	"name": "DATAFLOWemployee second highest dept",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText1",
						"type": "DatasetReference"
					},
					"name": "sourcedataflow"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DelimitedText1",
						"type": "DatasetReference"
					},
					"name": "sinkdataflowemployee"
				}
			],
			"transformations": [
				{
					"name": "SECONDHIGHESTSALARY"
				},
				{
					"name": "filterHIGHESTSECOND"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ID as integer,",
				"          Experience_Years as integer,",
				"          Age as integer,",
				"          Gender as string,",
				"          Salary as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     partitionBy('hash', 1)) ~> sourcedataflow",
				"sourcedataflow window(over(ID),",
				"     asc(toInteger('ID'), true),",
				"     desc(toInteger(byName('Salary')), true),",
				"     asc(Experience_Years, true),",
				"     asc(Age, true),",
				"     rn = rowNumber(),",
				"     partitionBy('hash', 1)) ~> SECONDHIGHESTSALARY",
				"SECONDHIGHESTSALARY filter(toInteger(byName(\"rn\")) ==1) ~> filterHIGHESTSECOND",
				"filterHIGHESTSECOND select(mapColumn(",
				"          ID,",
				"          Experience_Years,",
				"          Age,",
				"          Gender,",
				"          Salary",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"SECONDHIGHESTSALARY sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID as string,",
				"          Experience_Years as string,",
				"          Age as string,",
				"          Gender as string,",
				"          Salary as string",
				"     ),",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sinkdataflowemployee"
			]
		}
	}
}